# PostgreSQL Business Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/business_db
DB_HOST=localhost
DB_PORT=5433
DB_NAME=business_db
DB_USER=postgres
DB_PASSWORD=postgres

# SQLite Memory Database Path
MEMORY_DB_PATH=./memory.db

# Server Configuration
BUSINESS_MCP_HOST=localhost
BUSINESS_MCP_PORT=8001
MEMORY_MCP_HOST=localhost
MEMORY_MCP_PORT=8002

# Docker Configuration
DEBUG=false
PYTHONUNBUFFERED=1
